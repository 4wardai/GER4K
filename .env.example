# ---------------------------------------------------------------------------
# GER4K — Environment Configuration (example)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values for local development.
# `.env` and `.env*.local` are gitignored; this `.env.example` is committed as
# documentation and MUST NOT contain any real secrets.
#
# SERVER-SIDE ONLY — DO NOT expose these to the browser.
#   All AI calls run server-side (through the /api/ask handler and the Bedrock
#   AI service). AI/AWS credentials MUST stay on the server and MUST NEVER be
#   read from client components. (Requirement 10.4)
#
#   Do NOT prefix any variable below with `NEXT_PUBLIC_`. In Next.js, the
#   `NEXT_PUBLIC_` prefix inlines a value into the client bundle, which would
#   leak these credentials to every visitor. Keep them unprefixed so they are
#   only available in the Node.js/server runtime.
#
# DETERMINISTIC FALLBACK — these are OPTIONAL to run the app.
#   GER4K ships a deterministic Ask GER4K explanation fallback, so the full
#   demo works even when none of these variables are set (no Bedrock access
#   required). Set them only to enable the live Bedrock-backed explanation.
# ---------------------------------------------------------------------------

# AWS region that hosts the Bedrock model (server-side only).
AWS_REGION=

# Region used for Bedrock calls. Defaults to AWS_REGION when unset (server-side only).
BEDROCK_REGION=

# Bedrock model identifier used for Ask GER4K explanations (server-side only).
# Example shape only (not a real/active id): anthropic.claude-3-haiku-xxxxxxxx
BEDROCK_MODEL_ID=

# ---------------------------------------------------------------------------
# AWS credentials (server-side only).
#
# PREFERRED in deployment (e.g. AWS Amplify Hosting): do NOT set these at all.
# Leave them empty and let the AWS default credential chain supply credentials
# via the attached IAM / Amplify service role. This avoids storing long-lived
# keys anywhere.
#
# For LOCAL development only, you may instead provide explicit keys below.
# Never commit real values — keep real keys in `.env.local` (gitignored).
# ---------------------------------------------------------------------------

# AWS access key id (server-side only; prefer the default credential chain).
AWS_ACCESS_KEY_ID=

# AWS secret access key (server-side only; prefer the default credential chain).
AWS_SECRET_ACCESS_KEY=

# Optional AWS session token for temporary credentials (server-side only).
AWS_SESSION_TOKEN=
